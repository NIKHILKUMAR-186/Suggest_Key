# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# (Optional Server-Side / Admin Service Role Key - Keep secret on backend only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----------------------------------------------------------------------------
# Help & Support
#
# No configuration. Support tickets live in this app's own database
# (`support_tickets`) and travel over the authenticated API in server.ts, so
# there is no third-party form endpoint and no client-visible support secret.
# Attachments go to the private `support-attachments` storage bucket, which is
# reached only through short-lived signed URLs minted per request.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Demo authentication (local development only)
#
# Disabled unless BOTH conditions are met:
#   1. ENABLE_DEMO_PERSONAS is exactly "true"
#   2. DEMO_TOKEN_SECRET is set and at least 32 characters
# Anything else fails closed, and known default secrets are rejected.
# Demo auth is always disabled when NODE_ENV=production, regardless of config.
#
# Generate a secret, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------------------
ENABLE_DEMO_PERSONAS="false"
DEMO_TOKEN_SECRET="at-least-32-characters-of-high-entropy"

# Email and password for the seeded admin account. The admin demo persona is
# only offered when ADMIN_PASSWORD is at least 12 characters, and login as that
# persona requires the password. Without it, only the seeker/mentor personas
# (which are one-click and hold no real data) are available.
ADMIN_EMAIL="admin@local.test"
ADMIN_PASSWORD=""

# ----------------------------------------------------------------------------
# Razorpay online payment (Phase 2, server-side only)
#
# Read only by the backend. None of these are prefixed with VITE_, so none of
# them can be bundled into the client. The key id is public by design and is the
# only one ever sent to a browser; the key secret and webhook secret must never
# leave the server.
#
# Every Razorpay endpoint answers 503 until RAZORPAY_ENABLED is exactly "true",
# so leaving this unset keeps the manual UPI flow as the only payment path.
# ----------------------------------------------------------------------------
RAZORPAY_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
